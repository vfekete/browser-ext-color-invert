{
  "manifest_version": 2,
  "name": "Dark/Light Mode Toggle",
  "version": "1.0",
  "description": "Toggle inversion globally or per page.",
  "permissions": ["activeTab", "storage", "tabs", "http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Dark/Light Mode"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-light-mode-toggle@example.local"
    }
  }
}
